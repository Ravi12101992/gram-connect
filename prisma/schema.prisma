// Prisma Schema for GramConnect
// Smart Village Development Platform (GramConnect)
// Configured for PostgreSQL (Supabase / Neon / Render) with full relations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CITIZEN
  ADMIN
  FIELD_WORKER
}

enum Category {
  SANITATION
  DRAINAGE
  DRINKING_WATER
  STREETLIGHTS
}

enum Status {
  PENDING
  REVIEWED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  VERIFIED_CLOSED
  REOPENED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  PLANNED
  APPROVED
  IN_PROGRESS
  COMPLETED
}

model User {
  id             String       @id @default(cuid())
  phone          String       @unique
  name           String
  role           Role         @default(CITIZEN)
  ward           String?
  language       String       @default("te")
  avatar         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  complaints     Complaint[]  @relation("CitizenComplaints")
  assignedTasks  Complaint[]  @relation("WorkerComplaints")
  workUpdates    WorkUpdate[]
}

model Complaint {
  id               String       @id // Format: GC-2026-1001
  category         Category
  title            String
  description      String
  ward             String
  landmark         String?
  latitude         Float?
  longitude        Float?
  photoUrl         String?
  status           Status       @default(PENDING)
  priority         Priority     @default(MEDIUM)
  targetDate       DateTime?
  citizenId        String
  citizen          User         @relation("CitizenComplaints", fields: [citizenId], references: [id])
  assignedWorkerId String?
  assignedWorker   User?        @relation("WorkerComplaints", fields: [assignedWorkerId], references: [id])
  assignedAt       DateTime?
  completedAt      DateTime?
  closedAt         DateTime?
  feedbackRating   Int?
  feedbackComment  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  updates          WorkUpdate[]
}

model WorkUpdate {
  id               String       @id @default(cuid())
  complaintId      String
  complaint        Complaint    @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  workerId         String
  worker           User         @relation(fields: [workerId], references: [id])
  notes            String
  photoUrl         String?
  statusFrom       Status
  statusTo         Status
  createdAt        DateTime     @default(now())
}

model VillageAsset {
  id          String   @id @default(cuid())
  name        String
  nameTe      String
  type        String   // tap, tank, drain, pole, toilet, road
  ward        String
  location    String
  latitude    Float
  longitude   Float
  condition   String   // Good, Needs Maintenance, Under Repair
  lastInspected DateTime @default(now())
}

model Project {
  id             String        @id @default(cuid())
  title          String
  titleTe        String
  description    String
  descriptionTe  String
  category       String
  location       String
  budget         Float
  fundingSource  String
  timeline       String
  status         ProjectStatus @default(IN_PROGRESS)
  progress       Int           @default(0) // 0 - 100%
  photoUrl       String?
  createdAt      DateTime      @default(now())
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  titleTe     String
  content     String
  contentTe   String
  category    String   // Water, Health, GramaSabha, Sanitation
  priority    String   // NORMAL, URGENT
  ward        String   // ALL or specific ward
  date        DateTime @default(now())
}

model EmergencyContact {
  id          String   @id @default(cuid())
  title       String
  titleTe     String
  name        String
  phone       String
  role        String
  roleTe      String
  available   String
}
